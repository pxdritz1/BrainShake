{
  "name": "brainshake",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "node --experimental-strip-types --test src/features/board/types.test.ts src/features/accessibility/accessibility.test.ts && vitest run src/features/workspace src/features/board/lib/objects.test.ts src/features/pen src/features/canvas/objects/CanvasObject.test.tsx src/features/toolbar/toolNavigation.test.ts src/features/preferences/dockPosition.test.ts",
    "format": "prettier --write src eslint.config.ts vite.config.ts tsconfig.json",
    "format:check": "prettier --check src eslint.config.ts vite.config.ts tsconfig.json"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dompurify": "^3.4.15",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "marked": "^18.0.13",
    "motion": "^13.4.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
